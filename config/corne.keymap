#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layers

#define WinDef  0
#define WinNav  1
#define MacDef  2
#define MacNav  3
#define Code    4
#define WinFunc 5
#define MacFunc 6
#define Mouse   7
#define System  8

/ {

    chosen {
      zmk,matrix_transform = &five_column_transform;
      zmk,physical-layout = &foostan_corne_5col_layout;
    };

    macros {
        zen: zen_browser {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LWIN>,
                <&kp LALT>,

                <&macro_tap>,
                <&kp SPACE>,

                <&macro_release>,
                <&kp LWIN>,
                <&kp LALT>,

                <&macro_pause_for_release>,
                <&macro_wait_time 150>,
                <&macro_tap>,
                <&kp Z>,
                <&kp E>,
                <&kp N>,
                <&kp ENTER>;
        };

        mzen: mac_zen_browser {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LCMD>,

                <&macro_tap>,
                <&kp SPACE>,

                <&macro_release>,
                <&kp LWIN>,

                <&macro_pause_for_release>,
                <&macro_wait_time 100>,
                <&macro_tap>,
                <&kp Z>,
                <&kp E>,
                <&kp N>,
                <&kp ENTER>;
        };
        
        edg: edge_browser {
           compatible = "zmk,behavior-macro";
           #binding-cells = <0>;
           wait-ms = <5>;
           tap-ms = <5>;
           bindings =
               <&macro_press>,
               <&kp LWIN>,
               <&kp LALT>,

               <&macro_tap>,
               <&kp SPACE>,

               <&macro_release>,
               <&kp LWIN>,
               <&kp LALT>,

               <&macro_pause_for_release>,
               <&macro_wait_time 150>,
               <&macro_tap>,
               <&kp E>,
               <&kp D>,
               <&kp G>,
               <&kp E>,
               <&kp ENTER>;
        };

        twin: terminal_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&kp LWIN>,

                <&macro_tap>,
                <&kp T>,

                <&macro_release>,
                <&kp LCTRL>,
                <&kp LWIN>,

                <&macro_wait_time 100>,
                <&macro_tap>,
                <&kp D>,
                <&kp ENTER>;
        };

        twinq: terminal_windows_quake {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&kp LWIN>,
                <&kp LALT>,

                <&macro_tap>,
                <&kp T>,

                <&macro_release>,
                <&kp LCTRL>,
                <&kp LWIN>,
                <&kp LALT>;
        };

        ptr: powertoy_run {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LWIN>,
                <&kp LALT>,

                <&macro_tap>,
                <&kp SPACE>,

                <&macro_release>,
                <&kp LWIN>,
                <&kp LALT>;
        };

        tmac: terminal_macos {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LCMD>,

                <&macro_tap>,
                <&kp SPACE>,
                <&kp N1>,

                <&macro_release>,
                <&kp LCMD>,

                <&macro_pause_for_release>,
                <&macro_wait_time 100>,
                <&macro_tap>,
                <&kp G>,
                <&kp H>,
                <&kp O>,
                <&kp S>,
                <&kp T>,
                <&kp T>,
                <&kp Y>,
                <&kp ENTER>;
        };

        mmac: windowmax_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LG(LCTRL)>,
                <&macro_tap>,
                <&kp F>,
                <&macro_release>,
                <&kp LG(LCTRL)>;
        };

        recm: screenrecord_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LG(LSHFT)>,
                <&macro_tap>,
                <&kp N5>,
                <&macro_release>,
                <&kp LG(LSHFT)>;
        };

        wupm: windowup_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&kp LCTRL>,

                <&macro_tap>,
                <&kp F>,

                <&macro_release>,
                <&kp GLOBE>,
                <&kp LCTRL>;
        };

        wdnm: windowdown_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&kp LCTRL>,

                <&macro_tap>,
                <&kp C>,

                <&macro_release>,
                <&kp GLOBE>,
                <&kp LCTRL>;
        };

        spot: spotlight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LCMD>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LCMD>;
        };

        mvu: move_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp K>,
                <&macro_release>,
                <&kp LALT>;
        };

        mvd: move_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp J>,
                <&macro_release>,
                <&kp LALT>;
        };

        col: tmux_column {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = 
                <&macro_tap>,
                <&kp LC(A)>,
                <&kp PIPE>;
        };

        row: tmux_row {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = 
                <&macro_tap>,
                <&kp LC(A)>,
                <&kp MINUS>;
        };

        lst: tmux_list {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = 
                <&macro_tap>,
                <&kp LC(A)>,
                <&kp W>;
        };

        tab: tmux_create {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = 
                <&macro_tap>,
                <&kp LC(A)>,
                <&kp C>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_control {
            bindings = <&kp LCTRL>;
            key-positions = <20 21>;
            layers = <0 2>;
            timeout-ms = <80>;
            require-prior-idle-ms = <150>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            layers = <0 2>;
            timeout-ms = <35>;
            require-prior-idle-ms = <150>;
        };
    };

    behaviors {
        tm: thumb_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
 
        lh: layer_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };       
    };

    keymap {
        compatible = "zmk,keymap";

        WinDef {
            display-name = "Windows";
            bindings = <
                &kp Q  &kp W  &kp E         &kp R     &kp T              &kp Y          &kp U            &kp I      &kp O    &kp P
                &kp A  &kp S  &kp D         &kp F     &kp G              &kp H          &kp J            &kp K      &kp L    &kp SEMI
                &kp Z  &kp X  &kp C         &kp V     &kp B              &kp N          &kp M            &kp COMMA  &kp DOT  &kp FSLH
                              &tm LALT ESC  &mo Code  &tm LSHFT SPACE    &tm LCTRL RET  &lh WinNav BSPC  &kp TAB
            >;
        };

        WinNav {
            display-name = "WinNav";
            bindings = <
                &kp N1         &kp N2         &kp N3        &kp N4    &kp N5       &kp N6        &kp N7        &kp N8      &kp N9      &kp N0
                &kp LG(LS(S))  &kp LG(SPACE)  &kp LG(UP)    &kp HOME  &kp PG_UP    &kp LEFT      &kp DOWN      &kp UP      &kp RIGHT   &kp LC(TAB)
                &twin_quake    &zen           &kp LG(DOWN)  &kp END   &kp PG_DN    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV  &kp C_NEXT  &kp C_PLAY_PAUSE
                                              &trans        &trans    &trans       &trans        &trans        &trans
            >;
        };

        MacDef {
            display-name = "MacOS";
            bindings = <
                &kp Q  &kp W  &kp E         &kp R     &kp T              &kp Y          &kp U            &kp I      &kp O    &kp P
                &kp A  &kp S  &kp D         &kp F     &kp G              &kp H          &kp J            &kp K      &kp L    &kp SEMI
                &kp Z  &kp X  &kp C         &kp V     &kp B              &kp N          &kp M            &kp COMMA  &kp DOT  &kp FSLH
                              &tm LCMD ESC  &mo Code  &tm LSHFT SPACE    &tm LCTRL RET  &lh MacNav BSPC  &kp TAB
            >;
        };

        MacNav {
            display-name = "MacNav";
            bindings = <
                &kp N1              &kp N2    &kp N3     &kp N4    &kp N5       &kp N6        &kp N7        &kp N8      &kp N9      &kp N0
                &kp LG(LC(LS(N4)))  &kp CAPS  &mmac      &kp HOME  &kp PG_UP    &kp LEFT      &kp DOWN      &kp UP      &kp RIGHT   &kp LC(TAB)
                &tmac               &mzen     &kp LG(M)  &kp END   &kp PG_DN    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV  &kp C_NEXT  &kp C_PLAY_PAUSE
                                              &trans     &trans    &trans       &trans        &trans        &trans
            >;
        };

        Code {
            display-name = "Code";
            bindings = <
                &kp EXCL  &kp AT  &kp HASH   &kp DLLR   &kp PRCNT    &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR
                &lst      &col    &kp GRAVE  &kp MINUS  &kp EQUAL    &kp LBRC   &kp RBRC  &kp SQT   &kp DQT   &kp LA(F4)
                &tab      &row    &kp TILDE  &kp PLUS   &kp UNDER    &kp LBKT   &kp RBKT  &kp PIPE  &kp BSLH  &kp DEL
                                  &trans     &trans     &trans       &trans     &trans    &trans
            >;
        };

        WinFunc {
            display-name = "WinFunc";
            bindings = <
                &kp F1     &kp F2  &kp F3  &kp F4  &kp F5       &kp F6      &kp F7         &kp F8          &kp F9            &kp F10
                &sk LWIN   &trans  &trans  &trans  &trans       &ptr        &trans         &trans          &kp F11           &kp F12
                &kp LG(I)  &twin   &trans  &trans  &to Mouse    &to System  &kp LG(LC(D))  &kp LG(LC(F4))  &kp LG(LC(LEFT))  &kp LG(LC(RIGHT))
                                   &trans  &trans  &trans       &trans      &trans         &trans
            >;
        };

        MacFunc {
            display-name = "MacFunc";
            bindings = <
                &kp F1           &kp F2  &kp F3  &kp F4  &kp F5     &kp F6      &kp F7  &kp F8  &kp F9        &kp F10
                &sk LALT         &trans  &wupm   &trans  &trans     &spot       &trans  &trans  &kp F11       &kp F12
                &kp LG(LA(ESC))  &trans  &wdnm   &trans  &to Mouse  &to System  &mvd    &mvu    &kp LC(LEFT)  &kp LC(RIGHT)
                                         &trans  &trans  &trans     &trans      &trans  &trans
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
                &kp ESC  &none  &none   &none       &none         &none           &none           &none         &none            &none
                &none    &none  &none   &none       &none         &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
                &none    &none  &none   &none       &none         &none           &msc SCRL_DOWN  &msc SCRL_UP  &none            &none
                                &trans  &to MacDef  &to WinDef    &mkp LCLK       &mkp RCLK       &mkp MCLK
            >;
        };

        System {
            display-name = "System";
            bindings = <
                &none  &none  &none  &none       &bt BT_CLR     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &none  &none  &none  &none       &sys_reset     &sys_reset    &none         &none         &none         &none
                &none  &none  &none  &none       &bootloader    &bootloader   &none         &none         &none         &none
                              &none  &to MacDef  &to WinDef     &trans        &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        win_function {
            if-layers = <1 4>;
            then-layer = <5>;
        };

        mac_function {
            if-layers = <3 4>;
            then-layer = <6>;
        };
    };
};
