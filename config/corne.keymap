#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layers

#define Def  0
#define Nav  1
#define Code    2
#define Func    3
#define Mouse   4
#define System  5

#define MACRO_WAIT_MS 30
#define MACRO_TAP_MS  30

/ {
    chosen {
      zmk,matrix_transform = &five_column_transform;
      zmk,physical-layout = &foostan_corne_5col_layout;
    };

    macros {
        zen: zen_browser {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <MACRO_WAIT_MS>;
            tap-ms = <MACRO_TAP_MS>;
            bindings =
                <&macro_press>,
                <&kp LWIN>,
                <&kp LALT>,

                <&macro_tap>,
                <&kp SPACE>,

                <&macro_release>,
                <&kp LWIN>,
                <&kp LALT>,

                <&macro_pause_for_release>,
                <&macro_wait_time 300>,
                <&macro_tap>,
                <&kp Z>,
                <&kp E>,
                <&kp N>,
                <&kp ENTER>;
        };

        twin: terminal_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <MACRO_WAIT_MS>;
            tap-ms = <MACRO_TAP_MS>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&kp LWIN>,

                <&macro_tap>,
                <&kp T>,

                <&macro_release>,
                <&kp LCTRL>,
                <&kp LWIN>,

                <&macro_wait_time 150>,
                <&macro_tap>,
                <&kp D>,
                <&kp ENTER>;
        };

        twinp: terminal_windows_powershell {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <MACRO_WAIT_MS>;
            tap-ms = <MACRO_TAP_MS>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&kp LWIN>,

                <&macro_tap>,
                <&kp T>,

                <&macro_release>,
                <&kp LCTRL>,
                <&kp LWIN>,

                <&macro_wait_time 100>,
                <&macro_tap>,
                <&kp P>,
                <&kp ENTER>;
        };

        ptr: powertoy_run {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <MACRO_WAIT_MS>;
            tap-ms = <MACRO_TAP_MS>;
            bindings =
                <&macro_press>,
                <&kp LWIN>,
                <&kp LALT>,

                <&macro_tap>,
                <&kp SPACE>,

                <&macro_release>,
                <&kp LWIN>,
                <&kp LALT>;
        };

        tmx: tmux_prefix {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&macro_tap &kp LC(A)>,
                       <&macro_param_1to1>,
                       <&macro_tap &kp MACRO_PLACEHOLDER>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            layers = <0>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };
    };

    behaviors {
        tm: thumb_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            require-prior-idle-ms = <120>;  // 連打時 Space/Enter 一律當 tap，避免誤觸 Shift/Ctrl
        };

        lh: layer_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <250>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Def {
            display-name = "Def";
            bindings = <
                &kp Q  &kp W  &kp E         &kp R     &kp T              &kp Y          &kp U         &kp I      &kp O    &kp P
                &kp A  &kp S  &kp D         &kp F     &kp G              &kp H          &kp J         &kp K      &kp L    &kp SEMI
                &kp Z  &kp X  &kp C         &kp V     &kp B              &kp N          &kp M         &kp COMMA  &kp DOT  &kp FSLH
                              &tm LALT ESC  &mo Code  &tm LSHFT SPACE    &tm LCTRL RET  &lh Nav BSPC  &kp TAB
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
                &kp N1         &kp N2         &kp N3        &kp N4    &kp N5       &kp N6        &kp N7        &kp N8      &kp N9      &kp N0
                &kp LG(LS(S))  &kp LG(SPACE)  &kp LG(UP)    &kp HOME  &kp PG_UP    &kp LEFT      &kp DOWN      &kp UP      &kp RIGHT   &kp LC(TAB)
                &twin          &zen           &kp LG(DOWN)  &kp END   &kp PG_DN    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV  &kp C_NEXT  &kp C_PLAY_PAUSE
                                              &trans        &trans    &trans       &trans        &trans        &trans
            >;
        };

        Code {
            display-name = "Code";
            bindings = <
                &kp EXCL  &kp AT      &kp HASH   &kp DLLR   &kp PRCNT    &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR
                &tmx W    &tmx PIPE   &kp GRAVE  &kp MINUS  &kp EQUAL    &kp LBRC   &kp RBRC  &kp SQT   &kp DQT   &trans
                &tmx C    &tmx MINUS  &kp TILDE  &kp PLUS   &kp UNDER    &kp LBKT   &kp RBKT  &kp PIPE  &kp BSLH  &kp DEL
                                      &trans     &trans     &trans       &trans     &trans    &trans
            >;
        };

        Func {
            display-name = "Func";
            bindings = <
                &kp F1     &kp F2   &kp F3   &kp F4  &kp F5       &kp F6      &kp F7         &kp F8          &kp F9            &kp F10
                &sk LWIN   &kp F11  &kp F12  &trans  &trans       &ptr        &kp LA(J)      &kp LA(K)       &trans            &kp LA(F4)
                &kp LG(I)  &twinp   &trans   &trans  &to Mouse    &to System  &kp LG(LC(D))  &kp LG(LC(F4))  &kp LG(LC(LEFT))  &kp LG(LC(RIGHT))
                                    &trans   &trans  &trans       &trans      &trans         &trans
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
                &kp ESC  &none  &none   &none  &none      &none           &none           &none         &none            &none
                &none    &none  &none   &none  &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
                &none    &none  &none   &none  &none      &none           &msc SCRL_DOWN  &msc SCRL_UP  &none            &none
                                &trans  &none  &to Def    &mkp LCLK       &mkp RCLK       &mkp MCLK
            >;
        };

        System {
            display-name = "System";
            bindings = <
                &none  &none  &none  &none  &bt BT_CLR     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &none  &none  &none  &none  &sys_reset     &sys_reset    &none         &none         &none         &none
                &none  &none  &none  &none  &bootloader    &bootloader   &none         &none         &none         &none
                              &none  &none  &to Def        &trans        &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        win_function {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
